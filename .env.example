# ========================================================
# DevPilot Monorepo - Environment Configuration Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/devra

# Security & Authentication
JWT_SECRET=devpilot_super_secret_jwt_key_change_me_in_production_32chars!
JWT_EXPIRES_IN=7d

# AI Model Configuration (Gemini or OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-pro

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Client Web App Configuration
VITE_API_URL=http://localhost:5000
