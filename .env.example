# Required in production: Set a unique 32+ character high-entropy secret.
# Generate a JWT secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: AI-powered reviews, chat, and agent plans
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL=gemini-1.5-pro

# Optional: GitHub OAuth (needed for account connection/import)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# For `npm run dev` use port 5001; for Docker Compose use port 5000.
# GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback
# Required in production: Unique 16+ character secret for GitHub webhook HMAC-SHA256 signature verification.
GITHUB_WEBHOOK_SECRET=

# Optional SMTP settings for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Devra <no-reply@your-verified-domain.com>

# Optional overrides; defaults work with this repository's Docker Compose setup
# MONGODB_URI=mongodb://mongodb:27017/devra
# REDIS_HOST=redis
# REDIS_PORT=6379
# VECTOR_STORE=redis
