{
  "name": "devra-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Devra - AI-powered developer platform with MERN stack, 3D codebase visualization, and VS Code extension",
  "workspaces": [
    "client",
    "server",
    "extension",
    "shared"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\"",
    "dev:infra": "docker compose up -d mongodb redis",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:extension": "npm --prefix extension run watch",
    "build": "npm run build:server && npm run build:client && npm run build:extension",
    "build:server": "echo \"Server ready (no build step required for Node.js)\"",
    "build:client": "npm --prefix client run build",
    "build:extension": "npm --prefix extension run compile",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "devra",
    "ai",
    "developer-platform",
    "code-analysis",
    "monorepo"
  ],
  "author": "Devra Team",
  "license": "MIT"
}
