# Optional server-only environment file for direct backend development.
# The backend also reads the project-root .env file as a fallback.
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/devra

# Required in production: Set a unique 32+ character high-entropy secret.
# In development (NODE_ENV=development), a safe local fallback is provided.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Redis is optional locally; the server falls back to an in-memory vector store.
REDIS_HOST=localhost
REDIS_PORT=6379
VECTOR_STORE=redis

# Optional AI provider settings
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# Optional GitHub OAuth settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback
# Required in production: Unique 16+ character secret for GitHub webhook HMAC-SHA256 validation.
GITHUB_WEBHOOK_SECRET=

# Optional SMTP settings for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Devra <no-reply@your-verified-domain.com>
