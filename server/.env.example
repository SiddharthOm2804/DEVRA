# ========================================================
# DevPilot / Devra - Server Environment Variables Template
# ========================================================

# Server Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Replica Set or Standalone)
MONGODB_URI=mongodb://localhost:27017/devra

# Security & Authentication (Generate secure 32+ character key for production)
JWT_SECRET=devpilot_super_secret_jwt_key_change_me_in_production_32chars!
JWT_EXPIRES_IN=7d

# AI Model Provider Configuration (gemini, openai, or local)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# GitHub Integration (OAuth App & Webhook credentials)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# Redis & RAG Vector Store Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
REDIS_TLS=false
VECTOR_STORE=redis
VECTOR_DIMENSION=128
REDIS_INDEX_NAME=devra:idx:codebase
REDIS_DOC_PREFIX=devra:doc:

# Production Observability & Prometheus Metrics
METRICS_AUTH_TOKEN=your_secure_bearer_token_for_metrics_scrape_endpoint
OTEL_ENABLED=false
OTEL_SERVICE_NAME=devra-server
OTEL_SERVICE_VERSION=1.0.0
